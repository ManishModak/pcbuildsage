EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=http://localhost:8888
PYTHON_PATH=

# Seed dataset download (Plan 7): override the GitHub Release base URL hosting products-<country>.db files
SEED_RELEASE_URL=

# Local mode only: extra host names (comma-separated) allowed to reach the API, for deliberate LAN use
PCBUILDSAGE_ALLOWED_HOSTS=

# Hosted demo (Turso catalog): read path used by the web server, ingest path
# used only by the refresh-catalog workflow (fine-grained tokens).
PCBUILDSAGE_DEPLOYMENT_MODE=local
TURSO_DATABASE_URL=
TURSO_READ_TOKEN=
TURSO_INGEST_TOKEN=

# Anonymous usage analytics (hosted free tiers only; local mode counts nothing).
# Separate Turso database from the catalog above — never reuse TURSO_* here.
ANALYTICS_TURSO_URL=
ANALYTICS_TURSO_TOKEN=
