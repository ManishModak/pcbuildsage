{
  "$schema": "../schemas/profile.schema.json",
  "schema_version": 1,
  "profile_name": "India Tech Stores",
  "country_code": "IN",
  "default_currency": "INR",
  "sites": [
    {
      "site_name": "Kryptronix",
      "base_url": "https://kryptronix.in/",
      "scraping_type": "category",
      "browser_config": {
        "headless": true,
        "js_rendering": true,
        "wait_for_selector": "li.product",
        "scroll_down": true,
        "timeout_ms": 30000
      },
      "categories": {
        "gpu": {
          "path": "product-category/graphic-cards/",
          "pagination_pattern": "page/{page}/",
          "max_pages": 20
        },
        "cpu": {
          "path": "product-category/processor/",
          "pagination_pattern": "page/{page}/",
          "max_pages": 20
        },
        "storage": {
          "path": "product-category/internal-ssd/",
          "pagination_pattern": "page/{page}/",
          "max_pages": 20
        }
      },
      "selectors": {
        "product_container": "li.product",
        "title": "h3.woocommerce-loop-product__title",
        "price": "span.price ins span.woocommerce-Price-amount, span.price span.woocommerce-Price-amount",
        "url": "a.woocommerce-LoopProduct-link",
        "image": "img.attachment-woocommerce_thumbnail",
        "out_of_stock": ".out-of-stock"
      }
    },
    {
      "site_name": "MDComputers",
      "base_url": "https://mdcomputers.in/",
      "scraping_type": "category",
      "browser_config": {
        "headless": true,
        "js_rendering": true,
        "wait_for_selector": ".product-grid-item",
        "scroll_down": true,
        "timeout_ms": 30000
      },
      "categories": {
        "gpu": {
          "path": "catalog/graphics-card",
          "pagination_pattern": "?page={page}",
          "max_pages": 20
        },
        "cpu": {
          "path": "catalog/processor",
          "pagination_pattern": "?page={page}",
          "max_pages": 20
        },
        "storage": {
          "path": "catalog/storage",
          "pagination_pattern": "?page={page}",
          "max_pages": 20
        }
      },
      "selectors": {
        "product_container": ".product-grid-item",
        "title": ".product-entities-title a",
        "price": ".price span.ins, .price span.amount",
        "url": ".product-entities-title a",
        "image": ".product-image-link img",
        "out_of_stock": ".out-of-stock"
      }
    }
  ]
}
